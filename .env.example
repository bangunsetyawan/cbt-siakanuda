# ============================================================================
# CBT SIAKANUDA — contoh konfigurasi
#
# Salin file ini menjadi `.env` (di root proyek), lalu isi nilai aslinya.
# File `.env` TIDAK masuk git.
#
# PERINGATAN: REPO INI PUBLIK. Jangan pernah menulis password, kunci, atau
# alamat IP internal di file ini. Semua nilai di bawah ini HANYA placeholder
# (CHANGE_ME) — ganti dengan nilai asli di file `.env` masing-masing.
# ============================================================================

# --------------------------------------------------------------------------
# ENVIRONMENT
# --------------------------------------------------------------------------

CI_ENVIRONMENT = development

# --------------------------------------------------------------------------
# APP
# --------------------------------------------------------------------------

# baseURL DIKOSONGKAN dengan sengaja: App.php mendeteksi host & skema dari
# request yang masuk (HTTP di LAN offline, HTTPS lewat Cloudflare Tunnel).
app.baseURL = ''

# --------------------------------------------------------------------------
# DATABASE (MariaDB di Docker)
# --------------------------------------------------------------------------

# Password database — dipakai DUA tempat (harus sama):
#  1. docker-compose.yml (membuat user MariaDB saat pertama jalan), dan
#  2. database.default.password di bawah (dipakai aplikasi CI4).
# Isi sekali di DB_PASSWORD; baris database.default.password di bawah
# otomatis mengikuti lewat ${DB_PASSWORD}.
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME_ROOT

database.default.hostname = mariadb
database.default.database = cbt_siakanuda
database.default.username = cbt_app
database.default.password = ${DB_PASSWORD}
database.default.DBDriver = MySQLi
database.default.port = 3306
